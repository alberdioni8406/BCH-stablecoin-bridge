# Application mode: "prototype" | "live"
# live = real THOR + Cauldron indexer quotes; never returns sample data
NEXT_PUBLIC_APP_MODE=live

# THORChain public endpoints (no key required for quotes)
THORNODE_URL=https://gateway.liquify.com/chain/thorchain_api
MIDGARD_URL=https://midgard.ninerealms.com

# Optional Rango public key (for optional routes)
# RANGO_API_KEY=

# Cauldron indexer (Riften Labs)
CAULDRON_INDEXER_URL=https://indexer.riften.net/cauldron
